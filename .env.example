# Function secrets. Set them with:
#   npx supabase secrets set --env-file .env --project-ref <project-ref>
# SUPABASE_URL and SUPABASE_SERVICE_ROLE_KEY are provided by Supabase automatically.

# Any long random string. Guards every recorder call, and the Recall webhook URL.
RECORDER_SECRET=

# Any other long random string. Signs recap links.
RECAP_SIGN_SECRET=

# Recall.ai (https://www.recall.ai): API key and the region of your workspace.
RECALL_API_KEY=
RECALL_REGION=us-west-2
# The signing secret (whsec_...) shown on your Recall webhook endpoint.
# With it set, only deliveries signed by Recall are accepted.
RECALL_SVIX_SECRET=

# Zernio (https://zernio.com): publishes the recording to your YouTube channel.
ZERNIO_API_KEY=

# Google AI Studio (free tier works): next steps + timeline.
GEMINI_API_KEY=
# Optional overrides:
# TIMELINE_MODEL=gemini-2.5-flash
# FALLBACK_MODEL=gemini-2.5-flash-lite

# Optional: the name the notetaker shows in the call.
# BOT_NAME=Notetaker
